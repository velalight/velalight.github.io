rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══ Helper Functions ═══ */
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wagdyme@aol.com' ||
        request.auth.token.email == 'itswagdy@gmail.com'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    /* ═══ المنتجات ═══ */
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ المراجعات ═══ */
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'rating', 'userId'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    /* ═══ الطلبات ═══ */
    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['orderId', 'items', 'total', 'phone', 'name', 'userId'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100;
    }

    /* ═══ العملاء ═══ */
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if signedIn() && request.auth.uid == userId;

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'email', 'city', 'address', 'provider'])
      );

      allow delete: if isAdmin();
    }

    /* ═══ الكوبونات ═══ */
    match /coupons/{couponId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || resource.data.public == true;

      allow write: if isAdmin();
    }

    /* ═══ Behind the Scenes ═══ */
    match /craftsmanship/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ حماية ═══ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
