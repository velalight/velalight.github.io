rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══ Helper Functions ═══ */
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wagdyme@aol.com' ||
        request.auth.token.email == 'itswagdy@gmail.com'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    /* ═══ المنتجات ═══ */
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ المراجعات ═══ */
    match /reviews/{reviewId} {
      allow read: if true;

      /* ✅ [تحقق] — منع المراجعات الفاضية */
      allow create: if
        request.resource.data.keys().hasAll(['name', 'rating'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow update, delete: if isAdmin();
    }

    /* ═══ الطلبات ═══ */
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();

      /* ✅ [تحقق] — منع الطلبات الفاضية والـ spam */
      allow create: if
        request.resource.data.keys().hasAll(['orderId', 'items', 'total', 'phone', 'name'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20;
    }

    /* ═══ العملاء ═══ */
    match /users/{userId} {
      allow read: if true;
      allow create: if true;

      /* ✅ [محسّن] — الأدمن أو صاحب الحساب أو تحديث محدود لحقول آمنة */
      allow update: if isAdmin()
        || isOwner(userId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ordersCount', 'totalSpent', 'lastOrder', 'name', 'phone', 'email', 'city', 'address', 'provider'])
        );

      allow delete: if isAdmin();
    }

    /* ═══ الكوبونات ═══ */
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ Behind the Scenes ═══ */
    match /craftsmanship/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ حماية ═══ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
