rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // دالة للتحقق من أن المستخدم مسجل دخول
    function signedIn() {
      return request.auth != null;
    }

    // دالة للتحقق من أن المستخدم هو المدير (Admin)
    function admin() {
      return signedIn()
        && (
          request.auth.token.email == "wagdyme@aol.com"
          || request.auth.token.email == "itswagdy@gmail.com"
        );
    }

    // ✅ [تعديل] قواعد المنتجات: القراءة للجميع، التعديل للمدير فقط
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // ✅ [تعديل] قواعد الطلبات:
    // - الزوار (غير المسجلين) مسموح لهم بإنشاء طلب (guest checkout)
    // - مع تحقق بسيط من صحة البيانات لمنع السبام
    // - المدير يقرأ ويعدل ويحذف كل الطلبات
    // - العميل المسجل يقرأ طلباته هو فقط
    match /orders/{orderId} {
      // 1. السماح بإنشاء الطلب للجميع (مع تحقق من صحة البيانات)
      allow create: if
        request.resource.data.keys().hasAll(['orderId', 'items', 'total', 'phone', 'name'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20;

      // 2. المدير: قراءة، تعديل، حذف أي طلب
      allow read, update, delete: if admin();

      // 3. العميل المسجل: قراءة طلباته هو فقط
      allow read: if signedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    // ✅ [تعديل] قواعد التقييمات:
    // - الزوار مسموح لهم بإنشاء تقييم (مع تحقق)
    // - القراءة للجميع
    // - التعديل والحذف للمدير فقط
    match /reviews/{reviewId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;

      allow read: if true;
      allow update, delete: if admin();
    }

    // ✅ [جديد] قواعد الكوبونات:
    // - القراءة للجميع (الموقع بيقرأها للتحقق)
    // - الكتابة للمدير فقط
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    // ✅ [جديد] قواعد العملاء (users):
    // - الإنشاء للجميع (guest checkout)
    // - التحديث المحدود (فقط الحقول الآمنة) للجميع
    // - القراءة والحذف الكامل للمدير
    match /users/{userId} {
      // إنشاء حساب عميل جديد
      allow create: if
        request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10;

      // تحديث محدود: فقط الحقول الآمنة (ordersCount, totalSpent, lastOrder)
      allow update: if admin()
        || request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['ordersCount', 'totalSpent', 'lastOrder']);

      // القراءة والحذف: للمدير فقط
      allow read, delete: if admin();
    }

    // قاعدة أمان شاملة: منع القراءة أو الكتابة لأي مجموعة بيانات أخرى
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
