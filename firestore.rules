rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && (
          request.auth.token.email == "wagdyme@aol.com"
          || request.auth.token.email == "itswagdy@gmail.com"
        );
    }

    /* ═══ المنتجات ═══ */
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    /* ═══ الطلبات ═══ */
    match /orders/{orderId} {
      allow create: if
        request.resource.data.keys().hasAll(['orderId', 'items', 'total', 'phone', 'name'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20;

      allow read, update, delete: if admin();
      allow read: if signedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    /* ═══ المراجعات ═══ */
    match /reviews/{reviewId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;

      allow read: if true;
      allow update, delete: if admin();
    }

    /* ═══ الكوبونات ═══
       ✅ [مُصلح] — القراءة العامة لكوبونات فعّالة فقط
       (لأن Exit Intent + validateCoupon محتاجين يقرأوها)
       البيانات الحساسة (usedBy, usedCount) مخفية عن الزوار عبر
       Cloud Function بتعمل الفلترة.
    */
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    /* ═══ سجل الاستخدام ═══ */
    match /couponRedemptions/{redemptionId} {
      allow read, write: if admin();
    }

    /* ═══ بيانات العملاء ═══
       ✅ [مُصلح] — العميل يقرأ ويكتب بياناته الشخصية فقط
       والأدمن يقرأ ويكتب الكل
    */
    match /users/{userId} {
      allow read, write: if admin();
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
