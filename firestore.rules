rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══════════════════════════════════════════════════════
       Helper Functions
       ═══════════════════════════════════════════════════════ */

    function signedIn() {
      return request.auth != null;
    }

    /* ✅ [مُصلح] — تم تصحيح إيميل الأدمن: itswagdy@gmail.com */
    function admin() {
      return signedIn()
        && (
          request.auth.token.email == "wagdyme@aol.com"
          || request.auth.token.email == "itswagdy@gmail.com"
        );
    }

    /* ═══════════════════════════════════════════════════════
       📦 المنتجات — قراءة للجميع، كتابة للمدير
       ═══════════════════════════════════════════════════════ */
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    /* ═══════════════════════════════════════════════════════
       🛒 الطلبات — guest checkout مسموح مع تحقق
       ═══════════════════════════════════════════════════════ */
    match /orders/{orderId} {
      /* إنشاء طلب من أي زائر مع تحقق بسيط */
      allow create: if
        request.resource.data.keys().hasAll(['orderId', 'items', 'total', 'phone', 'name'])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20;

      /* الأدمن يقرأ ويعدل ويحذف كل الطلبات */
      allow read, update, delete: if admin();

      /* العميل المسجل يقرأ طلباته هو فقط */
      allow read: if signedIn()
        && resource.data.userId != null
        && resource.data.userId == request.auth.uid;
    }

    /* ═══════════════════════════════════════════════════════
       ⭐ المراجعات — إنشاء للجميع، قراءة للجميع، تعديل للمدير
       ═══════════════════════════════════════════════════════ */
    match /reviews/{reviewId} {
      allow create: if
        request.resource.data.keys().hasAll(['name', 'rating'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50;

      allow read: if true;
      allow update, delete: if admin();
    }

    /* ═══════════════════════════════════════════════════════
       🎟️ الكوبونات
       ✅ [مُصلح] — القراءة عامة (Exit Intent + validateCoupon محتاجينها)
       الكتابة للمدير فقط
       ═══════════════════════════════════════════════════════ */
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    /* ═══════════════════════════════════════════════════════
       🔐 سجل استخدام الكوبونات — للمدير فقط
       (العميل ما بيحتاجش يقرأه — validateCoupon بتتعامل معاه من السيرفر)
       ═══════════════════════════════════════════════════════ */
    match /couponRedemptions/{redemptionId} {
      allow read, write: if admin();
    }

    /* ═══════════════════════════════════════════════════════
       👤 بيانات العملاء
       ✅ [مُصلح] — العميل يقرأ ويكتب بياناته الشخصية فقط
       والأدمن يقرأ ويكتب الكل
       ═══════════════════════════════════════════════════════ */
    match /users/{userId} {
      /* الأدمن: قراءة + كتابة كاملة */
      allow read, write: if admin();

      /* العميل: قراءة + كتابة بياناته هو فقط */
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    /* ═══════════════════════════════════════════════════════
       🚫 منع أي مجموعة تانية
       ═══════════════════════════════════════════════════════ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
