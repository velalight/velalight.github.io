rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ═══ Helper Functions ═══ */
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'wagdyme@aol.com' ||
        request.auth.token.email == 'itswag@gmail.com'
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function signedIn() {
      return request.auth != null;
    }

    function validReview() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'name',
          'rating',
          'userId',
          'productSlug',
          'text',
          'createdAt',
          'approved'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'rating',
          'userId',
          'productSlug',
          'text',
          'createdAt',
          'approved'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 50
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productSlug is string
        && request.resource.data.productSlug.size() >= 1
        && request.resource.data.productSlug.size() <= 100
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is number
        && request.resource.data.approved == false;
    }

    /* ═══ المنتجات ═══ */
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ المراجعات ═══ */
    match /reviews/{reviewId} {
      // يقرأ الزوار المراجعات التي وافق عليها المشرف فقط.
      // يستطيع المشرف قراءة المراجعات المعلقة أيضًا.
      allow read: if isAdmin() || resource.data.approved == true;

      // لا يستطيع العميل اعتماد مراجعته أو إضافة حقول أخرى.
      allow create: if isAdmin() || validReview();

      allow update, delete: if isAdmin();
    }

    /* ═══ الطلبات ═══ */
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // ينشئ الطلبات العملاء عبر خدمة خادمية موثوقة،
      // أما إنشاء الطلب اليدوي من لوحة الإدارة فيبقى للمشرف.
      allow create: if isAdmin();

      allow update, delete: if isAdmin();
    }

    /* ═══ العملاء ═══ */
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'email', 'city', 'address', 'provider'])
      );

      allow delete: if isAdmin();
    }

    /* ═══ الكوبونات ═══ */
    match /coupons/{couponId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid)
        || resource.data.public == true;

      allow write: if isAdmin();
    }

    /* ═══ Behind the Scenes ═══ */
    match /craftsmanship/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ═══ حماية افتراضية لباقي المجموعات ═══ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
